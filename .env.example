# Storage Mode: "local" (SSD storage in data/qdrant_db) or "cloud" (hosted Qdrant Cloud)
QDRANT_STORAGE=cloud
QDRANT_LOCAL_PATH=data/qdrant_db
QDRANT_COLLECTION=simple_wiki

# Qdrant Cloud Credentials (required when QDRANT_STORAGE=cloud)
QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-api-key-here

# Optional Generation Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
CONFIDENCE_THRESHOLD=0.40
